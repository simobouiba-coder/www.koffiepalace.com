# ── Koffie Palace – Omgevingsvariabelen ──────────────────────────────────────
#
# Kopieer dit bestand naar .env en vul jouw gegevens in.
# Het .env bestand nooit uploaden naar internet of delen!

# Mollie API key
# Testmodus:  begint met test_  → geen echte betalingen
# Livemodus:  begint met live_  → echte betalingen
MOLLIE_API_KEY=test_JOUW_MOLLIE_API_KEY_HIER

# De URL van jouw website (zonder / aan het einde)
# Lokaal testen:  http://localhost:3000
# Live website:   https://www.koffiepalace.nl
BASE_URL=http://localhost:3000

# Poort (optioneel, standaard 3000)
PORT=3000
